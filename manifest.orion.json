{
  "manifest_version": 3,
  "name": "SlimGPT",
  "description": "A lightweight takeover UI for your own ChatGPT web session, tuned for Orion's WebExtension compatibility layer.",
  "version": "0.3.0",
  "icons": {
    "48": "icons/slimgpt-48.png",
    "128": "icons/slimgpt-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["isolated-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*", "main-mitm.js"],
      "matches": ["https://chatgpt.com/*"]
    }
  ]
}
