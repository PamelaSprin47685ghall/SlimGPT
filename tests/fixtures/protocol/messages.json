    },
    "metadata": {
     "content_references": [
      {
       "matched_text": "citeturn0search0",
       "type": "grouped_webpages",
       "items": [
        {
         "title": "Wiki",
         "url": "https://en.wikipedia.org/wiki/Paris"
        }
       ]
      }
     ]
    }
   },
   "expect": {
    "blocks": [
     {
      "kind": "text",
      "markdown": "Paris is the capital .",
      "citations": [
       {
        "start": 21,
        "end": 21,
        "sources": [
         {
          "url": "https://en.wikipedia.org/wiki/Paris",
          "title": "Wiki"
         }
        ]
       }
      ]
     }
    ]
   }
  },
