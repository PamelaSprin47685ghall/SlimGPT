{
  "manifest_version": 3,
  "name": "SlimGPT",
  "description": "A lightweight takeover UI for your own ChatGPT web session. Firefox uses a page-world bridge and never reads cookies.",
  "version": "0.3.0",
  "icons": {
    "48": "icons/slimgpt-48.png",
    "128": "icons/slimgpt-128.png"
  },
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["isolated-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["main-mitm.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*", "main-mitm.js"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slimgpt@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {}
  }
}
