{
  "name": "slimgpt",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode chrome",
    "build": "npm run build:extension && npm run build:firefox && npm run build:orion",
    "build:extension": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:orion": "node scripts/build.mjs orion",
    "test": "node --test tests/protocol tests/page tests/ui",
    "test:markdown": "node scripts/markdown-smoke.mjs",
    "check": "node scripts/check.mjs",
    "test:page": "node --test tests/page"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "katex": "^0.18.5",
    "streaming-markdown": "0.2.15",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "vite": "8.2.2"
  }
}
